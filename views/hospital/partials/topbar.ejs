<header class="topbar" style="display:none;" id="topbar">
  <div class="brand">
    <div class="brand-mark">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M12 21s-7.5-4.6-10-9.2C0.3 8.1 2 4.5 5.6 4c2-.3 3.8.6 5 2.1 1.2-1.5 3-2.4 5-2.1C19.2 4.5 20.9 8.1 19.2 12 16.7 16.4 12 21 12 21z" stroke="#1B3E73" stroke-width="1.6" fill="none"/>
        <path d="M4 12h3.2l1.4-2.6 2 4.6 1.6-3.4 1 1.4h5.4" stroke="#A81C2C" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="brand-text">
      <div class="name" id="hospNameHeader">Trividha</div>
      <div class="sub">Hospital Manager Dashboard</div>
    </div>
  </div>

  <div class="ayush-top">
    <span class="lbl">🌿 AYUSH listed</span>
    <label class="switch">
      <input type="checkbox" id="ayushSwitch">
      <span class="slider"></span>
    </label>
  </div>

  <div class="topbar-right">
    <button class="icon-btn" id="settingsBtn" title="Hospital profile">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" stroke="#16294F" stroke-width="1.7"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="#16294F" stroke-width="1.5"/></svg>
    </button>
    <div class="admin-chip">
      <div class="admin-avatar" id="adminAvatar">H</div>
      <div>
        <div class="who" id="adminEmail">—</div>
        <div class="role">Hospital Manager</div>
      </div>
    </div>
    <button class="icon-btn" id="logoutBtn" title="Sign out">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="#16294F" stroke-width="1.8" stroke-linecap="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="#16294F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>
