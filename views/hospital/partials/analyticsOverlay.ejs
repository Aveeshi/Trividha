<div class="analytics-overlay" id="analyticsOverlay">
  <div class="an-head">
    <div>
      <h2>Hospital analytics</h2>
      <p>Patients seen per day — hover a bar segment to see which doctor handled how many.</p>
    </div>
    <button class="btn btn-ghost" id="closeAnalyticsBtn">Close</button>
  </div>
  <div class="an-body">
    <div class="an-controls">
      <select id="rangeSelect">
        <option value="7">Last 7 days</option>
        <option value="14" selected>Last 14 days</option>
        <option value="30">Last 30 days</option>
        <option value="90">Last 90 days</option>
      </select>
    </div>
    <div class="chart-panel">
      <div class="chart-wrap"><canvas id="analyticsChart"></canvas></div>
    </div>

    <div class="seed-panel">
      <h3>Completed Consultations</h3>
      <p class="panel-sub">Recent completed appointments tracked across hospital doctors.</p>
      <table class="visits-table">
        <thead><tr><th>Date</th><th>Doctor</th><th>Count</th></tr></thead>
        <tbody id="visitsTableBody"></tbody>
      </table>
    </div>
  </div>
</div>
