<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Trividha — Hospital Manager Dashboard', css: 'dashboard' }) %>
</head>
<body>

<div class="loading-screen" id="loadingScreen">
  <div style="font-family:'Poppins',sans-serif; font-size:24px; color:var(--blue); font-weight:700;">Loading...</div>
</div>

<%- include('../partials/topbar') %>

<main id="mainContent" style="display:none;">
  <div class="stats-row" id="statsRow">
    <!-- Populated by dashboard.js renderStats() -->
  </div>

  <div class="landing-grid">
    <!-- Left Column: Doctors -->
    <div class="col-main">
      <div class="col-head">
        <div>
          <h2>Doctor Roster</h2>
          <p>Manage the doctors available at your hospital.</p>
        </div>
        <div class="toolbar-actions">
          <button class="btn btn-ghost btn-sm" id="openAnalyticsBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="margin-right:4px; vertical-align:middle;"><path d="M18 20V10m-6 10V4M6 20v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Analytics
          </button>
          <button class="btn btn-ghost btn-sm" id="uploadExcelBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="margin-right:4px; vertical-align:middle;"><path d="M12 4v12m0-12l-4 4m4-4l4 4M4 20h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Import
          </button>
          <button class="btn btn-primary btn-sm" id="addDoctorBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="margin-right:4px; vertical-align:middle;"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Add Doctor
          </button>
        </div>
      </div>
      
      <div class="toolbar">
        <div class="search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input type="text" id="searchInput" placeholder="Search by name, spec, or Gov ID...">
        </div>
      </div>

      <div class="doctor-list" id="doctorList">
        <!-- Populated by dashboard.js renderDoctors() -->
      </div>
    </div>

    <!-- Right Column: Kiosks -->
    <div class="col-side">
      <div class="col-head">
        <div>
          <h2>Kiosks</h2>
          <p>Registered check-in devices.</p>
        </div>
      </div>

      <div class="kiosk-list" id="kioskList">
        <!-- Populated by dashboard.js renderKiosks() -->
      </div>
      
      <div class="sync-bar">
        <div class="sync-left">
          <div class="sync-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 8-8m8 8a8 8 0 0 1-8 8m-6-3l-2 3h3m10-12l2-3h-3" stroke="#1B3E73" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="sync-text">
            <div class="t1">Push to kiosks</div>
            <div class="t2" id="lastSyncText">Not yet synced</div>
          </div>
        </div>
        <button class="btn btn-blue btn-sm" id="pushKioskBtn">Sync now</button>
      </div>
    </div>
  </div>
</main>

<div class="toast" id="toast"></div>

<%- include('../partials/profileModal') %>
<%- include('../partials/doctorModal') %>
<%- include('../partials/importModal') %>
<%- include('../partials/analyticsOverlay') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js/dist/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
