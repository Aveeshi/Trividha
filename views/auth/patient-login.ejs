<%- include('../partials/head', { title: 'Patient Login - Trividha' }) %>
<%- include('../partials/topbar') %>

  <main>
    <section class="view is-active">
      <div class="auth-card">
        <h1 data-i18n="login_patient_title">Patient Login</h1>
        <p class="auth-sub" data-i18n="login_patient_sub">Enter your Aadhaar number or ABHA ID to continue.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="form-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login/patient/send-otp" id="identify-form">
          <div class="form-group">
            <label class="form-label" for="aadhaar" data-i18n="label_aadhaar">Aadhaar Number (12 digits)</label>
            <input class="form-input" type="text" inputmode="numeric" maxlength="12" id="aadhaar" name="aadhaar" placeholder="XXXXXXXXXXXX" />
          </div>

          <div class="form-or-divider" data-i18n="or_divider">OR</div>

          <div class="form-group">
            <label class="form-label" for="abha" data-i18n="label_abha">ABHA ID (14 digits)</label>
            <input class="form-input" type="text" inputmode="numeric" maxlength="14" id="abha" name="abha" placeholder="XXXXXXXXXXXXXX" />
          </div>

          <button type="submit" class="form-submit" data-i18n="btn_send_otp">Send OTP</button>
        </form>

        <p class="auth-footnote"><a href="/home">&larr; <span data-i18n="back_to_roles">Back to role selection</span></a></p>
      </div>
    </section>
  </main>

<%- include('../partials/footer', { extraScript: '/js/auth.js' }) %>
