<%- include('partials/head', { title: 'Trividha - Choose your role' }) %>
<%- include('partials/topbar') %>

  <main>
    <section class="view is-active">
      <div class="hero">
        <p class="eyebrow" data-i18n="home_eyebrow">TRIVIDHA HOSPITAL</p>
        <h1 data-i18n="home_title">Who's checking in today?</h1>
        <p class="subtext" data-i18n="home_subtext">Choose your role below to log in and continue.</p>
      </div>

      <div class="role-cards">
        <a class="role-card role-card--patient" href="/login/patient">
          <div class="role-card-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <span class="role-card-title" data-i18n="role_patient_title">Patient</span>
          <span class="role-card-desc" data-i18n="role_patient_desc">Book appointments, check in, and manage your health records.</span>
          <span class="role-card-cta" data-i18n="role_login_cta">Login</span>
        </a>

        <a class="role-card role-card--doctor" href="/login/doctor">
          <div class="role-card-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M9 3v4a3 3 0 0 0 6 0V3M9 3H7v6a5 5 0 0 0 10 0V3h-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="18" cy="17" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M18 15.5v3M16.5 17h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </div>
          <span class="role-card-title" data-i18n="role_doctor_title">Doctor</span>
          <span class="role-card-desc" data-i18n="role_doctor_desc">Access your schedule, patient queue, and consultation tools.</span>
          <span class="role-card-cta" data-i18n="role_login_cta">Login</span>
        </a>

        <a class="role-card role-card--hospital" href="/login/hospital">
          <div class="role-card-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="4" y="8" width="16" height="13" stroke="currentColor" stroke-width="1.6"/><path d="M9 21v-6h6v6M12 3v5M9.5 5.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <span class="role-card-title" data-i18n="role_hospital_title">Hospital</span>
          <span class="role-card-desc" data-i18n="role_hospital_desc">Manage kiosks, staff, and hospital-wide operations.</span>
          <span class="role-card-cta" data-i18n="role_login_cta">Login</span>
        </a>

        <a class="role-card role-card--kiosk" href="/login/kiosk">
          <div class="role-card-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <span class="role-card-title" data-i18n="role_kiosk_title">Kiosk</span>
          <span class="role-card-desc" data-i18n="role_kiosk_desc">Set up or manage a self check-in kiosk device.</span>
          <span class="role-card-cta" data-i18n="role_login_cta">Login</span>
        </a>
      </div>

      <button type="button" class="link-btn" onclick="window.location.href='/?change=1'" data-i18n="change_language">Change language</button>
    </section>
  </main>

<%- include('partials/footer') %>
