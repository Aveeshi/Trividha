<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Trividha Hospital Kiosk</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>

  <!-- ============ TOP BAR ============ -->
  <header class="topbar">
    <div class="brand">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2 4.6 5.6 4c2.1-.4 3.9.6 6.4 3 2.5-2.4 4.3-3.4 6.4-3C22 4.6 23.6 8.4 22 11.7 19.5 16.4 12 21 12 21z" stroke="#B3242C" stroke-width="1.6" fill="#FBEAEA"/>
        <path d="M3 12h4l2-4 3 8 2-5 1.5 1H21" stroke="#1D5FBF" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="brand-text">
        <span class="brand-name">Trividha</span>
        <span class="brand-sub" data-i18n="brand_sub">Hospital Kiosk</span>
      </div>
    </div>

    <div class="topbar-right">
      <div class="clock">
        <span id="clock-time">--:--</span>
        <span id="clock-date">-- ---</span>
      </div>

      <button type="button" class="lang-pill" id="lang-pill-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h9M9.5 5v3c0 4-2 7-5.5 9M8 8c0 4 2.5 7.5 7 9.5M15 21l4-9 4 9M16.5 18h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-lang-pill>English</span>
      </button>

      <div class="text-size-toggle" role="group" aria-label="Text size">
        <button type="button" data-text-step="-0.1" aria-label="Decrease text size">A-</button>
        <button type="button" data-text-step="0.1" aria-label="Increase text size">A+</button>
      </div>
    </div>
  </header>

  <main>

    <!-- ============ VIEW: LANGUAGE SELECT ============ -->
    <section id="view-language" class="view">
      <button type="button" class="wizard-back" id="lang-back-btn" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-i18n="back">Back</span>
      </button>
      <div class="lang-select-head">
        <h1 data-i18n="choose_language_title">Choose your language</h1>
        <p class="subtext">भाषा चुनें &middot; भाषा निवडा &middot; மொழியைத் தேர்ந்தெடுக்கவும்</p>
      </div>
      <div class="lang-grid" id="lang-grid"></div>
    </section>

  </main>

  <!-- ============ EMERGENCY BUTTON ============ -->
  <button type="button" class="emergency-btn" id="emergency-btn">
    <span class="emergency-pulse" aria-hidden="true"></span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2 3 14h7l-1 8 10-13h-7l1-7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" fill="currentColor"/></svg>
    <span data-i18n="emergency">Emergency</span>
  </button>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <span data-i18n="helper_note">Need help? Visit the front desk or ask any staff member.</span>
    <span class="footer-divider">&middot;</span>
    <span data-i18n="footer_helpline">Helpline: 1800-103-2043</span>
  </footer>

  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
