<%- include('../partials/head', { title: 'Patient Dashboard - Trividha' }) %>
<%- include('../partials/topbar') %>

  <main>
    <section class="view is-active">
      <div class="hero">
        <p class="eyebrow" data-i18n="dashboard_welcome">WELCOME</p>
        <h1><%= patient.first_name %> <%= patient.last_name %></h1>
        <p class="subtext" data-i18n="dashboard_subtitle">What would you like to do today?</p>
      </div>

      <div class="cards">
        <button type="button" class="card card--kiosk" data-action="book-appointment">
          <div class="card-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <span class="card-title" data-i18n="card_book_title">Book Appointment</span>
          <span class="card-desc" data-i18n="card_book_desc">Find a doctor, pick a slot, and book your visit.</span>
          <span class="card-cta" data-i18n="card_cta_start">Start</span>
        </button>

        <button type="button" class="card card--qr" data-action="scan-documents">
          <div class="card-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 12h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <span class="card-title" data-i18n="card_scan_title">Scan / Upload Documents</span>
          <span class="card-desc" data-i18n="card_scan_desc">Add prescriptions, reports, or scans to your record.</span>
          <span class="card-cta" data-i18n="card_cta_start">Start</span>
        </button>
      </div>

      <p class="helper-note"><span data-i18n="signed_in_prefix">Signed in with Aadhaar ending</span> &bull;&bull;&bull;&bull; <%= patient.aadhaar_number.slice(-4) %></p>
    </section>
  </main>

<%- include('../partials/footer') %>
