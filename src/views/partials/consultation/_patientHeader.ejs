  <!-- Patient Header -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-4 shrink-0 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-xl font-bold text-slate-500">
        <%= patient.name.charAt(0) %>
      </div>
      <div>
        <h2 class="text-xl font-bold text-slate-800"><%= patient.name %></h2>
        <div class="flex items-center gap-3 text-sm text-slate-500 mt-0.5">
          <span class="font-medium"><%= patient.age %><%= patient.gender %></span>
          <span>•</span>
          <span class="flex items-center gap-1"><i data-lucide="fingerprint" class="w-3 h-3"></i> <%= patient.abhaId %></span>
          <span>•</span>
          <span class="flex items-center gap-1 text-red-600 font-medium"><i data-lucide="droplet" class="w-3 h-3 fill-red-600"></i> <%= patient.bloodGroup %></span>
        </div>
      </div>
    </div>
    <div class="text-right">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-bold shadow-md">
          <%= apt.token %>
        </span>
        <span class="text-sm font-medium text-slate-500">Token</span>
      </div>
      <p class="text-xs text-slate-400 mt-1"><i data-lucide="clock" class="w-3 h-3 inline"></i> <%= apt.time %> • City General Hospital</p>
    </div>
  </div>
