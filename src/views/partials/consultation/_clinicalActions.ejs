<!-- Prescription Modal Overlay -->
<div id="prescription-modal" class="hidden fixed inset-0 z-50 flex flex-col bg-slate-100 h-screen w-screen overflow-hidden">
  
  <!-- Header -->
  <div class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0 z-10 shadow-sm">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold">
        <i data-lucide="pen-tool" class="w-5 h-5"></i>
      </div>
      <div>
        <h2 class="font-bold text-slate-800 leading-tight">Write Prescription</h2>
        <p class="text-xs font-medium text-slate-500"><%= patient.name %> • <%= patient.abhaId %></p>
      </div>
    </div>
    
    <button onclick="closePrescriptionModal()" class="text-slate-400 hover:text-slate-600 p-2 bg-slate-50 hover:bg-slate-100 rounded-full transition-colors">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <!-- Body -->
  <div class="flex-1 overflow-hidden p-6 max-w-4xl w-full mx-auto flex flex-col">
    <div class="w-full h-full bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden">
      <div class="flex border-b border-slate-200 shrink-0">
        <button onclick="switchTab('actions', 'prescription')" id="tab-prescription" class="flex-1 py-3 text-sm font-bold text-blue-600 border-b-2 border-blue-600 bg-blue-50/50">Prescribe</button>
        <button onclick="switchTab('actions', 'labs')" id="tab-labs" class="flex-1 py-3 text-sm font-bold text-slate-500 hover:text-slate-700 hover:bg-slate-50">Order Labs</button>
      </div>
      
      <div class="flex-1 p-6 overflow-y-auto">
        <!-- Prescription Tab -->
        <div id="content-prescription" class="h-full flex flex-col">
          <div class="flex-1 space-y-5">
            <div>
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wide">Diagnosis / Impression</label>
              <input type="text" class="w-full mt-1.5 border border-slate-200 rounded-lg p-3 text-sm font-medium focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. Viral Pharyngitis">
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wide">Medicines (Rx)</label>
                <button onclick="addRxItem()" class="text-xs font-bold text-blue-600 flex items-center gap-1 hover:text-blue-700 bg-blue-50 px-2 py-1 rounded">
                  <i data-lucide="plus" class="w-3 h-3"></i> Add Medicine
                </button>
              </div>
              
              <div id="rx-items-container" class="space-y-3">
                <!-- Initial Rx Item Row -->
                <div class="rx-row grid grid-cols-6 gap-3 bg-slate-50 p-4 rounded-lg border border-slate-200 relative group">
                  <div class="col-span-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Medicine Name</label>
                    <input type="text" class="rx-medicine-name w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. Paracetamol">
                  </div>
                  <div class="col-span-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Dosage</label>
                    <input type="text" class="rx-dosage w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="500mg">
                  </div>
                  <div class="col-span-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Frequency</label>
                    <input type="text" class="rx-frequency w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="1-1-1">
                  </div>
                  <div class="col-span-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Duration</label>
                    <input type="text" class="rx-duration w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="5 days">
                  </div>
                  <div class="col-span-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Disease</label>
                    <input type="text" class="rx-disease w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Fever">
                  </div>
                  <div class="col-span-6">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Instructions</label>
                    <input type="text" class="rx-instructions w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="After food">
                  </div>
                  <button onclick="this.parentElement.remove()" class="absolute -right-2 -top-2 bg-white border border-red-200 text-red-500 rounded-full p-1 hidden group-hover:block hover:bg-red-50 shadow-sm"><i data-lucide="x" class="w-3 h-3"></i></button>
                </div>
              </div>
            </div>
            <div>
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wide">General Patient Instructions</label>
              <input type="text" class="w-full mt-1.5 border border-slate-200 rounded-lg p-3 text-sm font-medium focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Drink warm water, review after 3 days">
            </div>
          </div>
          
          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-end gap-3">
            <button onclick="window.print()" class="px-6 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2">
              <i data-lucide="printer" class="w-4 h-4"></i> Print
            </button>
            <button onclick="savePrescriptionAsDoc()" class="px-6 py-2.5 bg-blue-600 text-white font-bold rounded-lg shadow-sm hover:bg-blue-700 transition-colors flex items-center gap-2">
              <i data-lucide="save" class="w-4 h-4"></i> Save (Generate PDF)
            </button>
          </div>
        </div>

        <!-- Labs & Docs Tab -->
        <div id="content-labs" class="hidden space-y-6">
          <div>
            <h4 class="text-sm font-bold text-slate-700 mb-2 flex items-center gap-2"><i data-lucide="microscope" class="w-4 h-4"></i> Add Lab Tests to Order</h4>
            <select class="w-full border border-slate-200 rounded-lg p-3 text-sm font-medium mb-3 focus:ring-2 focus:ring-blue-500 outline-none">
              <option>CBC (Complete Blood Count)</option>
              <option>LFT (Liver Function Test)</option>
              <option>HbA1c</option>
              <option>Thyroid Profile (T3, T4, TSH)</option>
            </select>
            <button class="w-full bg-slate-100 text-slate-700 font-bold py-2.5 rounded-lg text-sm hover:bg-slate-200 transition-colors">Add Selected Test</button>
          </div>
          
          <div class="pt-6 border-t border-slate-100">
            <h4 class="text-sm font-bold text-slate-700 mb-2 flex items-center gap-2"><i data-lucide="file-scan" class="w-4 h-4"></i> Selected Tests</h4>
            <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 text-sm flex items-center justify-between">
              <span class="font-bold text-blue-800">CBC (Complete Blood Count)</span>
              <button class="text-blue-400 hover:text-red-500"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function openPrescriptionModal() {
  document.getElementById('prescription-modal').classList.remove('hidden');
}

function closePrescriptionModal() {
  document.getElementById('prescription-modal').classList.add('hidden');
}

async function savePrescriptionAsDoc() {
  const rows = document.querySelectorAll('.rx-row');
  const items = [];
  
  rows.forEach(row => {
    const medName = row.querySelector('.rx-medicine-name').value;
    if (medName.trim() === '') return;
    
    items.push({
      medicine_name: medName,
      dosage: row.querySelector('.rx-dosage').value,
      frequency: row.querySelector('.rx-frequency').value,
      duration: row.querySelector('.rx-duration').value,
      disease_name: row.querySelector('.rx-disease').value,
      instructions: row.querySelector('.rx-instructions').value
    });
  });

  if (items.length === 0) {
    alert('Please add at least one medicine.');
    return;
  }

  try {
    const urlParams = new URLSearchParams(window.location.search);
    const aptId = urlParams.get('aptId');
    const res = await fetch('/api/prescriptions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items, aptId })
    });
    
    if (res.ok) {
        const data = await res.json();
        const presId = data.prescription_id;
        
        alert('Success! The prescription has been saved to Supabase.\n\nDownloading PDF now...');
        
        // Open PDF in new tab/download
        if (presId) {
          window.open('/api/prescriptions/' + presId + '/pdf', '_blank');
        }
        
        // Short delay to allow download to trigger before redirecting
        setTimeout(() => {
          window.location.href = '/queue';
        }, 1000);
      } else {
        alert('Error saving prescription');
      }
  } catch (e) {
    console.error(e);
    alert('Error saving prescription');
  }
}

function addRxItem() {
  const container = document.getElementById('rx-items-container');
  const row = document.createElement('div');
  row.className = 'rx-row grid grid-cols-6 gap-3 bg-slate-50 p-4 rounded-lg border border-slate-200 relative group';
  row.innerHTML = `
    <div class="col-span-2">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Medicine Name</label>
      <input type="text" class="rx-medicine-name w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. Paracetamol">
    </div>
    <div class="col-span-1">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Dosage</label>
      <input type="text" class="rx-dosage w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="500mg">
    </div>
    <div class="col-span-1">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Frequency</label>
      <input type="text" class="rx-frequency w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="1-1-1">
    </div>
    <div class="col-span-1">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Duration</label>
      <input type="text" class="rx-duration w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="5 days">
    </div>
    <div class="col-span-1">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Disease</label>
      <input type="text" class="rx-disease w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Fever">
    </div>
    <div class="col-span-6">
      <label class="text-[10px] font-bold text-slate-500 uppercase">Instructions</label>
      <input type="text" class="rx-instructions w-full mt-1 border border-slate-200 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="After food">
    </div>
    <button onclick="this.parentElement.remove()" class="absolute -right-2 -top-2 bg-white border border-red-200 text-red-500 rounded-full p-1 hidden group-hover:block hover:bg-red-50 shadow-sm">
      <i data-lucide="x" class="w-3 h-3"></i>
    </button>
  `;
  container.appendChild(row);
  lucide.createIcons();
}
</script>
