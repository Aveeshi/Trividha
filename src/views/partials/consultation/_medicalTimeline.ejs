    <!-- Medical Timeline -->
    <div class="w-full h-full bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden">
      <div class="flex border-b border-slate-200 shrink-0">
        <button onclick="switchTab('timeline', 'high-alert')" id="tab-high-alert" class="flex-1 py-3 text-sm font-bold text-red-600 border-b-2 border-red-600 bg-red-50/50">High Alert</button>
        <button onclick="switchTab('timeline', 'prescriptions')" id="tab-prescriptions" class="flex-1 py-3 text-sm font-bold text-slate-500 hover:text-slate-700 hover:bg-slate-50">Full History</button>
      </div>
      <div class="flex-1 overflow-y-auto p-4 bg-slate-50">
        
        <!-- High Alerts Content -->
        <div id="content-high-alert" class="space-y-3">
          <% timeline.filter(t => t.type === 'high-alert').forEach(evt => { %>
            <div class="bg-red-50 border border-red-100 rounded-lg p-3 relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-red-500"></div>
              <div class="flex items-center gap-2 mb-1">
                <i data-lucide="alert-triangle" class="w-4 h-4 text-red-600"></i>
                <h4 class="font-bold text-red-800 text-sm"><%= evt.title %></h4>
              </div>
              <p class="text-xs text-red-700"><%= evt.details %></p>
              <p class="text-[10px] text-red-400 mt-2"><%= evt.hospital %> • <%= evt.date %></p>
            </div>
          <% }) %>
        </div>

        <!-- Full History (Timeline & Summary) Content -->
        <div id="content-prescriptions" class="space-y-4 hidden">
          <!-- History Summary Textbox -->
          <div class="bg-amber-50 text-amber-900 px-4 py-3 rounded-lg text-sm border border-amber-200">
            <p class="text-xs font-bold uppercase tracking-wider mb-1 opacity-75">Clinical Summary</p>
            <p>Patient presents with a history of recurrent conditions requiring intermittent monitoring. Responds well to standard treatments. No known complications to active medications.</p>
          </div>

          <h4 class="font-bold text-slate-700 text-sm mt-4 border-b pb-2">Medical Timeline</h4>
          <div class="relative border-l-2 border-slate-200 ml-2 space-y-6">
            <% timeline.forEach(evt => { %>
              <div class="relative pl-6">
                <!-- Timeline Dot -->
                <div class="absolute -left-[5px] top-1 w-2.5 h-2.5 rounded-full ring-4 ring-slate-50 <%= evt.type === 'high-alert' ? 'bg-red-500' : 'bg-blue-500' %>"></div>
                
                <div class="bg-white border <%= evt.type === 'high-alert' ? 'border-red-200' : 'border-slate-200' %> rounded-lg p-3 shadow-sm">
                  <div class="flex justify-between items-start mb-1">
                    <h4 class="font-bold <%= evt.type === 'high-alert' ? 'text-red-700' : 'text-slate-700' %> text-sm flex items-center gap-1.5">
                      <i data-lucide="<%= evt.type === 'high-alert' ? 'alert-triangle' : 'file-text' %>" class="w-3.5 h-3.5"></i>
                      <%= evt.title || (evt.type === 'prescription' ? 'Prescription' : 'Event') %>
                    </h4>
                    <span class="text-xs font-semibold text-slate-400"><%= evt.date %></span>
                  </div>
                  
                  <% if (evt.details) { %>
                    <p class="text-xs <%= evt.type === 'high-alert' ? 'text-red-600' : 'text-slate-600' %> mb-2"><%= evt.details %></p>
                  <% } %>
                  
                  <p class="text-xs text-slate-500 mb-2 font-medium"><i data-lucide="building-2" class="w-3 h-3 inline mr-1 opacity-70"></i><%= evt.hospital %></p>
                  
                  <% if (evt.type === 'prescription' && evt.medicines) { %>
                    <ul class="text-xs text-slate-700 space-y-1 bg-slate-50 p-2 rounded border border-slate-100 mt-2">
                      <% evt.medicines.forEach(m => { %>
                        <li><span class="font-bold"><%= m.name %></span> - <%= m.dosage %> (<%= m.frequency %>)</li>
                      <% }) %>
                    </ul>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
