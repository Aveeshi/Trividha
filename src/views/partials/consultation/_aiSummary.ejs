      <% if (aiSummary) { %>
      <div class="bg-gradient-to-br from-blue-50 to-blue-50 rounded-xl border border-blue-100 shadow-sm p-5 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 opacity-10">
          <i data-lucide="sparkles" class="w-24 h-24 text-blue-600"></i>
        </div>
        <div class="flex items-center justify-between mb-4 relative z-10">
          <h3 class="text-lg font-bold text-blue-900 flex items-center gap-2">
            <i data-lucide="bot" class="w-5 h-5 text-blue-600"></i> AI Pre-Consultation Summary
          </h3>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold bg-white text-blue-600 px-2 py-1.5 rounded border border-blue-200 shadow-sm uppercase tracking-wider">
              Doctor Verification Required
            </span>
            <button onclick="alert('Verification saved');" class="text-xs font-bold bg-blue-600 text-white px-3 py-1.5 rounded shadow-sm hover:bg-blue-700 transition-colors uppercase tracking-wider">
              Confirm Reviewed
            </button>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4 relative z-10">
          <div class="col-span-2 bg-white rounded-lg p-3 border border-blue-100 shadow-sm">
            <h4 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Chief Complaint</h4>
            <p class="text-slate-800 font-medium"><%= aiSummary.chiefComplaint %> <span class="text-slate-500 font-normal">(Duration: <%= aiSummary.duration %>)</span></p>
          </div>
          
          <div class="bg-white rounded-lg p-3 border border-blue-100 shadow-sm">
            <h4 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Symptoms</h4>
            <ul class="list-disc list-inside text-sm text-slate-700 space-y-0.5">
              <% aiSummary.symptoms.forEach(s => { %> <li><%= s %></li> <% }) %>
            </ul>
          </div>
          
          <div class="bg-white rounded-lg p-3 border border-blue-100 shadow-sm">
            <h4 class="text-xs font-semibold text-blue-400 uppercase tracking-wider mb-1">Current Medications</h4>
            <ul class="list-disc list-inside text-sm text-slate-700 space-y-0.5">
              <% aiSummary.currentMedications.forEach(m => { %> <li><%= m %></li> <% }) %>
            </ul>
          </div>
          
          <div class="col-span-2 bg-amber-50 rounded-lg p-3 border border-amber-200 shadow-sm flex gap-3 items-start">
            <i data-lucide="info" class="w-5 h-5 text-amber-600 shrink-0 mt-0.5"></i>
            <div>
              <h4 class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1">Important Observations</h4>
              <p class="text-amber-900 text-sm font-medium"><%= aiSummary.observations %></p>
            </div>
          </div>
        </div>
        
        <div class="mt-4 flex justify-end relative z-10">
          <button onclick="document.getElementById('voice-modal').classList.remove('hidden')" class="flex items-center gap-2 text-sm font-bold text-blue-600 bg-white px-4 py-2 rounded-lg border border-blue-200 hover:bg-blue-50 transition-colors shadow-sm">
            <i data-lucide="mic" class="w-4 h-4"></i> View Voice Interview
          </button>
        </div>
      </div>
      <% } else { %>
      <div class="bg-slate-50 rounded-xl border border-dashed border-slate-300 p-8 text-center flex flex-col items-center justify-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-slate-300 mb-4 shadow-sm">
          <i data-lucide="bot-off" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-700 mb-1">No AI Summary Available</h3>
        <p class="text-sm text-slate-500">This patient did not complete the AI pre-consultation interview before their appointment.</p>
      </div>
      <% } %>
