<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- title || 'Doctor Portal' %></title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <!-- Lucide Icons via CDN (using a script version that runs in browser) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      /* Custom styles to mimic any lost React classes if needed */
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-900 font-sans">
    
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar Partial (example, you can move this to partials/sidebar.ejs later) -->
      <aside class="w-64 bg-white border-r border-slate-200 flex flex-col hidden md:flex">
         <div class="p-4 border-b border-slate-200 flex items-center justify-between">
           <div class="flex items-center gap-2">
             <i data-lucide="activity" class="w-6 h-6 text-blue-600"></i>
             <span class="font-bold text-lg text-slate-800">Trividha</span>
           </div>
         </div>
         <nav class="flex-1 overflow-y-auto p-4 space-y-1">
           <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors 
             <%= typeof path !== 'undefined' && path === '/' ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
             <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
           </a>
           <a href="/hospitals" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
             <%= typeof path !== 'undefined' && path.startsWith('/hospitals') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
             <i data-lucide="building" class="w-5 h-5"></i> My Hospitals
           </a>

           <a href="/consultation" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
             <%= typeof path !== 'undefined' && path.startsWith('/consultation') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
             <i data-lucide="stethoscope" class="w-5 h-5"></i> Consultations
           </a>
           <a href="/performance" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
             <%= typeof path !== 'undefined' && path.startsWith('/performance') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
             <i data-lucide="bar-chart-2" class="w-5 h-5"></i> Performance
           </a>
         </nav>
         
      </aside>

      <!-- Main Content -->
      <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
          <!-- Topbar -->
          <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shrink-0 z-10">
            <div class="flex items-center">
              <button onclick="document.getElementById('mobile-sidebar').classList.remove('hidden')" class="md:hidden text-slate-500 mr-3 p-1 rounded-md hover:bg-slate-100">
                <i data-lucide="menu" class="w-6 h-6"></i>
              </button>
              <h1 class="text-xl font-semibold text-slate-800"><%- typeof headerTitle !== 'undefined' ? headerTitle : 'Trividha' %></h1>
            </div>
            
            <div class="flex items-center gap-4">
              <a href="/hospitals" class="hidden md:flex items-center px-3 py-1.5 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg text-sm text-slate-600 mr-2 transition-colors cursor-pointer">
                <i data-lucide="building-2" class="w-4 h-4 mr-2"></i>
                <span class="font-medium"><%= typeof currentHospital !== 'undefined' && currentHospital ? currentHospital.name : 'Select Hospital' %></span>
              </a>
              
              <button class="text-slate-400 hover:text-blue-600 transition-colors p-1.5 hidden sm:block">
                <i data-lucide="search" class="w-5 h-5"></i>
              </button>
              <button class="relative p-2 text-slate-400 hover:bg-slate-50 rounded-full hidden sm:block">
                <i data-lucide="bell" class="w-5 h-5"></i>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"></span>
              </button>
              
              <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
              
              <a href="/profile" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-semibold text-sm">
                  <%= typeof doctor !== 'undefined' && doctor.name ? doctor.name.split(' ').map(n => n[0]).slice(0,2).join('') : 'DR' %>
                </div>
                <div class="hidden sm:block text-sm">
                  <p class="font-medium text-slate-700"><%= typeof doctor !== 'undefined' ? doctor.name : 'Doctor' %></p>
                  <p class="text-xs text-slate-500"><%= typeof doctor !== 'undefined' ? doctor.specialization : 'Specialist' %></p>
                </div>
              </a>

              <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
              
              <form action="/login" method="GET" class="inline">
                <button type="submit" class="text-slate-400 hover:text-red-600 transition-colors p-1.5" title="Logout">
                  <i data-lucide="log-out" class="w-5 h-5"></i>
                </button>
              </form>
            </div>
          </header>

          <!-- Main scrollable content -->
          <main class="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-50 relative">
            <%- body %>
          </main>
      </div>
    </div>

    <!-- Mobile Sidebar Slide-over -->
    <div id="mobile-sidebar" class="hidden fixed inset-0 z-50 md:hidden">
      <!-- Backdrop -->
      <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" onclick="document.getElementById('mobile-sidebar').classList.add('hidden')"></div>
      
      <!-- Panel -->
      <aside class="fixed inset-y-0 left-0 w-72 bg-white shadow-2xl flex flex-col transition-transform transform">
        <div class="p-6 border-b border-slate-200 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center">
              <i data-lucide="activity" class="w-5 h-5 text-white"></i>
            </div>
            <span class="font-bold text-lg text-slate-800">Trividha</span>
          </div>
          <button onclick="document.getElementById('mobile-sidebar').classList.add('hidden')" class="text-slate-400 hover:bg-slate-100 p-1.5 rounded-lg">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <nav class="flex-1 overflow-y-auto p-4 space-y-1">
          <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors 
            <%= typeof path !== 'undefined' && path === '/' ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
          </a>
          <a href="/hospitals" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
            <%= typeof path !== 'undefined' && path.startsWith('/hospitals') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
            <i data-lucide="building" class="w-5 h-5"></i> My Hospitals
          </a>

          <a href="/consultation" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
            <%= typeof path !== 'undefined' && path.startsWith('/consultation') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
            <i data-lucide="stethoscope" class="w-5 h-5"></i> Consultations
          </a>
          <a href="/performance" class="flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors
            <%= typeof path !== 'undefined' && path.startsWith('/performance') ? 'bg-blue-50 text-blue-700' : 'hover:bg-blue-50 hover:text-blue-700 text-slate-700' %>">
            <i data-lucide="bar-chart-2" class="w-5 h-5"></i> Performance
          </a>
        </nav>
        
      </aside>
    </div>

    <!-- Initialize Icons -->
    <script>
      lucide.createIcons();
    </script>
    <%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
