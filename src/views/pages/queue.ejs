<div class="max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div class="flex items-center gap-4">
      <a href="javascript:history.back()" class="text-slate-400 hover:text-blue-600"><i data-lucide="arrow-left" class="w-6 h-6"></i></a>
      <div>
        <h2 class="text-2xl font-semibold text-slate-800">Patient Queue</h2>
        <p class="text-slate-500 mt-1">Live tracking of patient tokens</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="simulateDelay()" class="px-4 py-2 border border-slate-200 text-slate-600 font-medium text-sm rounded-lg hover:bg-slate-50">
        Mark Patient Delayed
      </button>
      <button class="px-4 py-2 bg-blue-600 text-white font-medium text-sm rounded-lg hover:bg-blue-700 flex items-center gap-2">
        <i data-lucide="play" class="w-4 h-4"></i> Advance Queue
      </button>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <% if (queue.length > 0) { %>
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 text-slate-500 border-b border-slate-200 text-sm uppercase tracking-wider">
          <th class="p-4 font-semibold">Token</th>
          <th class="p-4 font-semibold">Patient</th>
          <th class="p-4 font-semibold">Age/Gender</th>
          <th class="p-4 font-semibold">Est. Time</th>
          <th class="p-4 font-semibold">Status</th>
          <th class="p-4 font-semibold text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100" id="queueTable">
        <% queue.forEach(apt => { %>
        <tr class="hover:bg-slate-50 transition-colors <%= apt.status === 'IN CONSULTATION' ? 'bg-blue-50/50' : apt.status === 'COMPLETED' ? 'opacity-60 bg-slate-50/50' : '' %>">
          <td class="p-4">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full font-bold
              <%= apt.status === 'IN CONSULTATION' ? 'bg-blue-600 text-white shadow-md' : 'bg-slate-100 text-slate-700' %>">
              <%= apt.token %>
            </span>
          </td>
          <td class="p-4">
            <div class="font-bold text-slate-800"><%= apt.patient.name %></div>
            <div class="text-xs font-medium text-slate-500 flex items-center gap-1 mt-0.5"><i data-lucide="fingerprint" class="w-3 h-3"></i> <%= apt.patient.abhaId %></div>
          </td>
          <td class="p-4 text-slate-600 font-medium"><%= apt.patient.age %> / <%= apt.patient.gender %></td>
          <td class="p-4 font-bold text-slate-700 eta-display"><%= apt.estimatedTime %></td>
          <td class="p-4">
            <span class="status-badge inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wide
              <%= apt.status === 'IN CONSULTATION' ? 'bg-blue-100 text-blue-700 border border-blue-200' : 
                  apt.status === 'WAITING' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 
                  'bg-slate-100 text-slate-600 border border-slate-200' %>">
              <%= apt.status %>
            </span>
            <div class="delay-msg hidden text-xs text-red-500 font-medium mt-1">Patient notified — ETA +1 hr</div>
          </td>
          <td class="p-4 text-right">
            <% if (apt.status === 'COMPLETED') { %>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-50 text-slate-400 border border-slate-200 rounded-lg text-sm font-bold cursor-not-allowed">
                <i data-lucide="check" class="w-4 h-4"></i> Done
              </span>
            <% } else { %>
              <a href="/workspace?aptId=<%= apt.id %>" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm">
                Consult
              </a>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="p-12 text-center flex flex-col items-center justify-center">
      <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-4">
        <i data-lucide="users" class="w-8 h-8"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-700 mb-1">Queue is empty</h3>
      <p class="text-slate-500">There are no patients currently waiting in this slot.</p>
    </div>
    <% } %>
  </div>
</div>

<script>
function simulateDelay() {
  // Simulates dynamic recalculation
  const etas = document.querySelectorAll('.eta-display');
  if(etas.length > 1) {
    etas[1].innerText = "10:45 AM";
    const statusBadges = document.querySelectorAll('.status-badge');
    statusBadges[1].className = "status-badge inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-red-100 text-red-700 border border-red-200";
    statusBadges[1].innerText = "DELAYED";
    document.querySelectorAll('.delay-msg')[1].classList.remove('hidden');
  }
}
</script>
